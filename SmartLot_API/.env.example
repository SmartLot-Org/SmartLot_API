# Plantilla de configuración del backend. Copiala a .env y completá los valores.
# .env está en .gitignore: nunca commitees secretos reales.
# `npm run check:env` valida que estén las obligatorias y que no queden placeholders.

# --- Servidor ---
PORT=3000
# development | production. En production se activan HSTS, cookies Secure y redirect a HTTPS.
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (la URL del frontend).
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (links de los mails) y del backend (notification_url de Mercado Pago).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# --- Base de datos (Supabase / PostgreSQL) ---
# Cadena de conexión del pooler. Para levantar el esquema: docs/schema.sql y después docs/roles.sql.
DATABASE_URL=
# Opcional: certificado CA (PEM) para validar TLS de la base. Sin él la conexión cifra pero no
# valida el certificado del pooler de Supabase (ver src/database/db.js).
DB_CA_CERT=

# --- Supabase (login con Google) ---
SUPABASE_URL=
# Clave service_role: solo en el servidor, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesión (JWT) ---
# Dos secretos distintos, largos y aleatorios (p. ej. `openssl rand -hex 48`).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Costo de bcrypt (12 en producción).
BCRYPT_ROUNDS=12

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
# Secreto de firma de los webhooks (panel de MP > Webhooks). Sin él el webhook responde 503.
MP_WEBHOOK_SECRET=
# true para usar el checkout de prueba (sandbox).
MP_SANDBOX=true
# approved para volver solo al sitio tras pagar (exige FRONTEND_URL https pública). Vacío = sin auto_return.
MP_AUTO_RETURN=

# --- Email (Mailtrap API) ---
# Remitente verificado y token de la API de Mailtrap.
EMAIL_USER=
EMAIL_PASS=
# Opcional: CA (PEM, admite \n escapados) para validar TLS contra Mailtrap.
EMAIL_CA_CERT=

# --- Google Maps (distancias y garages cercanos) ---
GOOGLE_MAPS_BACKEND_KEY=
